<?xml version="1.0" encoding="UTF-8"?>
<!--
  Polaris-TerminalOS local manifest —— lineage-22.2（可构建基线，先跑这条）

  【路线归属】本文件是**交付线**（K2-04 结案口径：Linux 4.9.337 / lineage-22.2）的构建输入，
  也是 scripts/init-sources.sh 在 lineage-22.2 分支（当前默认）下自动选用的 manifest。
  交付线 pin：local_manifests/pins-22.2.txt（7 项）；构建前校验：`bash scripts/verify-pins.sh`（只读）。
  23.2 实验路线用 terminalos.xml；纯上游基线用 baseline-22.2.xml。

  【2026-11-01 变更：框架/内核裁剪落点切到自有 fork】
    用户授权「只改自己账号下的仓库，不动上游」。为此本条交付线的两处构建输入改指自有 fork：
      - frameworks/base  -> GStarX/android_frameworks_base（terminalos/lineage-22.2，起点 e1d69875）
      - kernel/xiaomi/sdm845 -> GStarX/android_kernel_xiaomi_sdm845（terminalos/lineage-22.2，起点 aa8adfe9）
    两个 fork 的起点 commit 与上游 lineage-22.2 **完全相同**，所以本条变更不改变任何源码内容，
    只改变「从哪里取」，为 S/SS/Z（framework）与 K（kernel defconfig）裁剪提供可写落点。
    frameworks/base 在上游 default.xml 里已注册为 LineageOS/android_frameworks_base，
    同 path 直接新增会 duplicate path，必须先 remove-project 再声明（顺序不能调换）。

  用法（在源码根目录）：
    mkdir -p .repo/local_manifests
    cp <本项目>/local_manifests/terminalos-22.2.xml .repo/local_manifests/terminalos.xml
    repo sync
    （或直接用 scripts/init-sources.sh，它会按分支自动选用本文件）

  checkout 场景（CI 的 baseline job）请用 baseline-22.2.xml（不叠加自有设备树 fork）。
-->
<manifest>
    <remote name="terminalos" fetch="https://github.com/GStarX/" />

    <project name="android_device_xiaomi_polaris"
             path="device/xiaomi/polaris"
             remote="terminalos"
             revision="terminalos/lineage-22.2" />
    <project name="android_vendor_terminalos"
             path="vendor/terminalos"
             remote="terminalos"
             revision="terminalos/lineage-22.2" />
    <project name="android_packages_apps_TerminalHome"
             path="packages/apps/TerminalHome"
             remote="terminalos"
             revision="terminalos/lineage-22.2" />

    <!--
      框架裁剪落点（方案甲清单 S/SS/Z 组）：SystemUI 组成、system_server 服务白名单、
      zygote preload。上游 default.xml 已有同 path 的 project，先摘后加。
    -->
    <remove-project name="LineageOS/android_frameworks_base" />
    <project name="android_frameworks_base"
             path="frameworks/base"
             remote="terminalos"
             revision="terminalos/lineage-22.2" />

    <!-- 内核截剪落点（K 组 defconfig）：起点与官方 lineage-22.2 同 commit（aa8adfe9） -->
    <project name="android_kernel_xiaomi_sdm845"
             path="kernel/xiaomi/sdm845"
             remote="terminalos"
             revision="terminalos/lineage-22.2" />

    <!-- blobs 仍取上游 TheMuppets（无自有 fork，terminalos 账号下不镜像闭源 blob） -->
    <project name="TheMuppets/proprietary_vendor_xiaomi_polaris"
             path="vendor/xiaomi/polaris"
             revision="lineage-22.2" />
    <project name="TheMuppets/proprietary_vendor_xiaomi_sdm845-common"
             path="vendor/xiaomi/sdm845-common"
             revision="lineage-22.2" />
</manifest>
